# Supabase (Milestone 1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Frontend origin(s) allowed to call this API, comma-separated
CORS_ORIGINS=http://localhost:3000

# OpenAI (Phase 4 onward -- orchestrator, RCA, memory, remediation)
OPENAI_API_KEY=

# AWS / CloudWatch (Phase 2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GitHub (Phase 2)
GITHUB_TOKEN=

# Jira (Phase 2, reused in Phase 14 for n8n ticket creation)
JIRA_SERVER=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Slack (Phase 2, reused in Phase 13 for notifications)
SLACK_BOT_TOKEN=

# Jenkins (Phase 2)
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# Kubernetes (Phase 2) -- no env var needed; reads ~/.kube/config locally,
# or in-cluster service account automatically when deployed